{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  
    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],
      "@entities": ["./src/entities"],
      "@entities/*": ["./src/entities/*"],
      "@features": ["./src/features"],
      "@features/*": ["./src/features/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@widgets": ["./src/widgets"],
      "@widgets/*": ["./src/widgets/*"],
      "@motorsport/race-engine": ["./packages/race-engine/src/index.ts"],
      "@features/multiplayer":   ["./src/features/multiplayer/index.ts"]
    }
  },
  "include": ["src", "packages/race-engine/src/types.ts", "packages/race-engine/src/calcDriverSpeed.ts", "packages/race-engine/src/engine.ts", "packages/race-engine/src/aiStrategyManager.ts", "packages/race-engine/src/index.ts"]
}
